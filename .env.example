# =============================================================================
# Smart Build - Environment Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# NEVER commit actual .env files containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Compass can be used to inspect)
MONGODB_URI=mongodb://localhost:27017/smart_build

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Client / Frontend Origin for CORS
CLIENT_URL=http://localhost:5173

# Local File Storage Path (for uploaded documents/photos in V1)
STORAGE_PATH=./storage

# Structured Logging Level (error, warn, info, http, debug)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Frontend Configuration (Vite requires VITE_ prefix for client-exposed variables)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_WS_URL=ws://localhost:5000
VITE_PORT=5173

# -----------------------------------------------------------------------------
# Initial Bootstrap / Seed Configuration (Used by npm run seed)
# -----------------------------------------------------------------------------
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@smartbuild.com
INITIAL_ADMIN_PASSWORD=Admin@123456
RESET_ADMIN_PASSWORD=false
